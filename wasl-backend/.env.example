# Wasl backend configuration — copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.

# --- Anthropic (required) ---
# Your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- API auth (required) ---
# A secret you invent. The frontend must send this same value as VITE_API_KEY.
API_KEY=change-me-to-a-random-string

# --- Langfuse observability (optional) ---
# From https://cloud.langfuse.com — leave blank to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
